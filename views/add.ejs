<%- include('./partials/header') %>

<!-- Adjusted responsive vertical padding to perfectly match the dashboard flow -->
<div class="container py-3 py-md-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <% if (errorMessage) { %>
    <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= errorMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>
            <!-- Back Button Link -->
            <div class="mb-3 mb-md-4">
                <a href="/items" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left-circle-fill"></i> Back to Dashboard
                </a>
            </div>

            <!-- Main Form Card (Corners match dashboard scale) -->
            <div class="card border-0 shadow-sm rounded-3 rounded-md-4">
                <div class="card-body p-4 p-sm-5">
                    
                    <div class="mb-3 text-center">
                        <h2 class="fw-bold text-dark fs-3 fs-md-2">Add New Item</h2>
                        <p class="text-muted small">Fill out the information below to register a new product to your inventory database.</p>
                    </div>

                    <hr class="text-muted opacity-25 my-3 my-md-4">

                    <form action="/items" method="POST" class="needs-validation" novalidate>
                        
                        <!-- Name Input (Fixed the missing closing div tag) -->
                        <div class="mb-3 mb-md-4">
                            <label for="name" class="form-label fw-semibold text-secondary small">Product Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-box"></i>
                                </span>
                                <input type="text" class="form-control bg-light border-start-0 ps-0 py-2" id="name" name="name" placeholder="Enter product name..." value="<%= oldInput.name || '' %>" required>
                            </div>
                        </div>

                        <!-- Price Input (Updated from USD to Rwf matching dashboard schema) -->
                        <div class="mb-3 mb-md-4">
                            <label for="price" class="form-label fw-semibold text-secondary small">Price (Rwf)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted small fw-semibold">Rwf</span>
                                <input type="number" class="form-control bg-light border-start-0 ps-0 py-2" id="price" name="price" step="1" min="0" placeholder="0" required>
                            </div>
                        </div>

                        <!-- Description Input -->
                        <div class="mb-3 mb-md-4">
                            <label for="description" class="form-label fw-semibold text-secondary small">Product Description</label>
                            <textarea class="form-control bg-light py-2" id="description" name="description" rows="4" placeholder="Describe your item key features, dimensions, or specifications..." required><%= oldInput.description || '' %></textarea>
                        </div> 
                        
                        <!-- Action Buttons -->
                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-end mt-4 mt-md-5 pt-3 border-top border-light">
                            <a href="/items" class="btn btn-light border px-4 py-2 order-2 order-sm-1 rounded-3">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm order-1 order-sm-2 rounded-3">
                                <i class="bi bi-check-lg me-1"></i> Save Product
                            </button>
                        </div>

                    </form> 
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Simple Bootstrap Validation Script -->
<script>
    (() => {
        'use strict'
        const forms = document.querySelectorAll('.needs-validation')
        Array.from(forms).forEach(form => {
            form.addEventListener('submit', event => {
                if (!form.checkValidity()) {
                    event.preventDefault()
                    event.stopPropagation()
                }
                form.classList.add('was-validated')
            }, false)
        })
    })()
</script>

<%- include('./partials/footer') %>