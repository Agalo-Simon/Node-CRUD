<%- include('./partials/header') %>

<div class="container py-3 py-md-4">
    
    <div class="d-flex flex-row justify-content-between align-items-center gap-2 mb-3 mb-md-4">
        <div>
            <h1 class="fw-bold text-primary m-0 fs-3 fs-md-2">Dashboard</h1>
        </div>
        <div>
            <a href="/items/add" class="btn btn-primary px-2.5 px-sm-3 py-1.5 fw-semibold shadow-sm rounded-3 btn-sm btn-md-base">
                <i class="bi bi-plus-lg me-1"></i> Add <span class="d-none d-sm-inline">New Item</span>
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 rounded-md-4 overflow-hidden">
        <% if (items && items.length > 0) { %>
            <!-- Responsive Table Layout -->
            <div class="table-responsive">
                <table class="table table-sm table-md-base table-hover align-middle mb-0">
                    <thead class="table-light border-bottom text-uppercase tracking-wider small">
                        <tr>
                            <th scope="col" class="ps-3 ps-md-4 py-2 py-md-3 text-secondary" style="width: 50px; min-width: 40px;">#</th>
                            <th scope="col" class="py-2 py-md-3 text-secondary" style="min-width: 120px;">Product Name</th>
                            <th scope="col" class="py-2 py-md-3 text-secondary d-none d-md-table-cell">Description</th>
                            <th scope="col" class="py-2 py-md-3 text-secondary" style="width: 110px; min-width: 95px;">Price</th>
                            <th scope="col" class="pe-3 pe-md-4 py-2 py-md-3 text-secondary text-end" style="width: 100px; min-width: 90px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% items.forEach((item, index) => { %>
                            <tr>
                                <td class="ps-3 ps-md-4 py-2 py-md-3 fw-medium text-muted small">
                                    <%= index + 1 %>
                                </td>
                                
                                <!-- Product Display Name -->
                                <td class="py-2 py-md-3">
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 140px; font-size: 0.9rem;"><%= item.name %></div>
                                    <div class="d-md-none text-muted small text-truncate" style="max-width: 140px;">
                                        <%= item.description %>
                                    </div>
                                </td>
                                
                                <!-- Desktop-Only Description Column -->
                                <td class="py-2 py-md-3 text-muted small text-truncate d-none d-md-table-cell" style="max-width: 250px;">
                                    <%= item.description %>
                                </td>
                                
                                <!-- Custom Price Badge Layout -->
                                <td class="py-2 py-md-3">
                                    <!-- Responsive font size scaling for the price badge -->
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-2 fw-semibold" style="font-size: 0.8rem;">
                                        Rwf <%= Number(item.price).toFixed(0) %>
                                    </span>
                                </td>
                                
                                <!-- Actions Control Group -->
                                <td class="pe-3 pe-md-4 py-2 py-md-3 text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a href="/items/edit/<%= item.id %>" class="btn btn-link btn-sm text-warning p-1" title="Edit Item">
                                            <i class="bi bi-pencil-square fs-5"></i>
                                        </a>
                                        
                                        <a href="/items/delete/<%= item.id %>" 
                                           class="btn btn-link btn-sm text-danger p-1" 
                                           title="Delete Item"
                                           onclick="return confirm('Are you completely sure you want to permanently delete this item?');">
                                            <i class="bi bi-trash fs-5"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <!-- Clean Empty State Layout -->
            <div class="text-center py-4 py-md-5 my-2">
                <div class="avatar bg-light rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-box-open fs-3 text-muted"></i>
                </div>
                <h5 class="fw-bold text-dark m-0">No products available</h5>
                <p class="text-muted small mx-auto mb-3 px-3" style="max-width: 280px;">Your warehouse database is currently clean and empty.</p>
                <a href="/items/add" class="btn btn-sm btn-primary px-3 py-1.5 fw-semibold rounded-3 shadow-sm">
                    Create Your First Entry
                </a>
            </div>
        <% } %>
        
    </div>
</div>

<%- include('./partials/footer') %>